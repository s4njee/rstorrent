# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# The web SPA build output. Keep the folder present (rust-embed reads it at
# compile time) but ignore the generated bundle.
/dist-web/*
!/dist-web/.gitkeep

# The GPUI desktop bundle (tools/bundle-gpui-macos.sh). Built output: it carries
# a copy of the staged rtorrent runtime.
/dist-gpui/

# The web server's local configuration: the daemon's endpoint and the auth mode
# for this machine, neither of which belongs in the repository. The server reads
# `rstorrent-web.toml` from its working directory.
/rstorrent-web.toml

# Cargo build output. The workspace target dir now lives at the repo root
# (the workspace Cargo.toml is here).
/target

# Claude Code local state (agent worktrees are full repo copies — never commit).
.claude/

# Bundled rtorrent runtime (built by tools/build-rtorrent-macos.sh). The binary
# and its dylibs are platform-specific, so they are built — never committed. The
# directory's README stays.
binaries/rtorrent-macos/*
!binaries/rtorrent-macos/README.md

# The Windows build's WSL runtime (built by tools/build-rtorrent-wsl.sh): the
# rstorrent distro's root filesystem, its checksum and build stamp. Built, never
# committed; only the README explaining how to rebuild it is tracked.
binaries/rtorrent-wsl/*
!binaries/rtorrent-wsl/README.md

# Playwright (WC10-S1): reports and traces are build output.
/test-results/
/playwright-report/
/blob-report/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Runtime state a local server run leaves behind.
server/move-journal.json

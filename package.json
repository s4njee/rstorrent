{
  "name": "rstorrent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The rstorrent web console frontend (React), served by the rstorrent-web server.",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "npm run build:web",
    "build:web": "tsc && vite build --config vite.web.config.ts",
    "preview": "vite preview --config vite.web.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build:web && playwright test",
    "e2e:install": "playwright install chromium",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^7.0.4",
    "vitest": "^3.0.0"
  }
}
